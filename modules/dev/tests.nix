# Contract tests: unit tests of ./lib, plus fixtures and templates evaluated as
# consumers would (nullkomma as their only input), whose checks, devshells and
# sites become checks of nullkomma itself.
{
  partitions.dev.module =
    { inputs, lib, ... }:
    let
      nullkomma = inputs.self;
      # Like `builtins.getFlake`, but pure and with `nullkomma` pointing at this
      # checkout (plus `module`); flake-parts' `debug` exposes the configuration to the tests.
      callFlakeWith =
        module: src:
        let
          flake = import (src + "/flake.nix");
          debugged = nullkomma // {
            lib = nullkomma.lib // {
              mkFlake =
                args: consumer:
                nullkomma.lib.mkFlake args {
                  imports = [
                    consumer
                    module
                  ];
                  debug = true;
                };
            };
          };
          flakeInputs = {
            self = self';
            nullkomma = debugged;
          };
          outputs = flake.outputs flakeInputs;
          self' = outputs // {
            _type = "flake";
            outPath = src;
            sourceInfo.outPath = src;
            inputs = flakeInputs;
            inherit outputs;
          };
        in
        self';
      callFlake = callFlakeWith { };
      fixtures = lib.genAttrs [ "md" "r" "r-remotes" "quarto" ] (
        name: callFlake ../../tests/fixtures/${name}
      );
      withoutLockfile = callFlakeWith {
        nullkomma.r.lockfile = ../../tests/fixtures/r/missing.lock;
      } ../../tests/fixtures/r;
      templates = lib.mapAttrs (_: t: callFlake t.path) nullkomma.templates;
    in
    {
      perSystem =
        { pkgs, system, ... }:
        let
          perSystem = flake: flake.allSystems.${system};
          has = attrs: name: attrs.${system} ? ${name};
          importTreeRoot = ../../tests/fixtures/import-tree;
          tests = {
            # keep-sorted start block=yes
            testConsumersExportSchemas = {
              expr = lib.mapAttrs (_: flake: {
                versions = map (name: flake.schemas.${name}.version) [
                  "apps"
                  "checks"
                  "devShells"
                  "formatter"
                  "packages"
                ];
                app =
                  (flake.schemas.apps.inventory flake.apps)
                  .children.${system}.children.write-files.evalChecks.isValidApp;
                check =
                  (flake.schemas.checks.inventory flake.checks).children.${system}.children.treefmt.isFlakeCheck;
                shell = (flake.schemas.devShells.inventory flake.devShells).children.${system}.children ? default;
                module =
                  (flake.schemas.flakeModules.inventory {
                    default = nullkomma.flakeModules.default;
                  }).children.default.evalChecks.isModule;
              }) (fixtures // lib.mapAttrs' (name: lib.nameValuePair "template-${name}") templates);
              expected =
                lib.genAttrs
                  [
                    "md"
                    "quarto"
                    "r"
                    "r-remotes"
                    "template-default"
                    "template-quarto"
                    "template-r"
                  ]
                  (_: {
                    versions = [
                      1
                      1
                      1
                      1
                      1
                    ];
                    app = true;
                    check = true;
                    shell = true;
                    module = true;
                  });
            };
            testGitignoreReincludesManagedFiles = {
              expr =
                let
                  lines = lib.splitString "\n" (perSystem fixtures.r).nullkomma.files.".gitignore".text;
                in
                {
                  envrc = lib.elem "!/.envrc" lines;
                  vscode = lib.elem "!/.vscode/settings.json" lines;
                  last = lib.last (lib.init lines) == "!/.vscode/settings.json";
                };
              expected = {
                envrc = true;
                vscode = true;
                last = true;
              };
            };
            testImportTreeSkipsUnderscoresAndNonNix = {
              expr = map (lib.removePrefix (toString importTreeRoot)) (
                map toString (nullkomma.lib.importTree importTreeRoot)
              );
              expected = [
                "/a.nix"
                "/sub/b.nix"
              ];
            };
            testInitializedFilesAreUserOwned = {
              expr = {
                cron = (perSystem fixtures.r).nullkomma.files ? ".github/workflows/cron.yml";
                driftCheck = has fixtures.r.checks "files";
                banner =
                  lib.hasInfix "Generated by nullkomma"
                    (perSystem fixtures.r).nullkomma.files.".github/workflows/push.yml".text;
              };
              expected = {
                cron = false;
                driftCheck = false;
                banner = false;
              };
            };
            testMdHasNoR = {
              expr = {
                air = (perSystem fixtures.md).treefmt.programs.air.enable;
                options = fixtures.md.debug.options.nullkomma ? r;
                check = has fixtures.md.checks "r-cmd-check";
              };
              expected = {
                air = false;
                options = false;
                check = false;
              };
            };
            testQuartoComposesWithR = {
              expr = {
                engines = map (p: p.name) (perSystem fixtures.quarto).nullkomma.quarto.engines;
                knitr = lib.elem "knitr" fixtures.quarto.debug.nullkomma.r.extraPackages;
                env = (perSystem fixtures.quarto).nullkomma.devshell.env ? QUARTO_R;
                check = has fixtures.quarto.checks "r-cmd-check";
              };
              expected = {
                engines = [ (perSystem fixtures.quarto).nullkomma.r.package.name ];
                knitr = true;
                env = true;
                check = false;
              };
            };
            testQuartoDeploys = {
              expr = {
                site = has fixtures.quarto.packages "site";
                deploy = has fixtures.quarto.apps "deploy";
                ci =
                  lib.hasInfix "CLOUDFLARE_API_TOKEN: \${{ secrets.CLOUDFLARE_API_TOKEN }}"
                    (perSystem fixtures.quarto).nullkomma.files.".github/workflows/push.yml".text;
              };
              expected = {
                site = true;
                deploy = true;
                ci = true;
              };
            };
            testQuartoTemplateWithoutProjectHasNoSite = {
              expr = {
                site = has templates.quarto.packages "site";
                tasks = lib.attrNames (
                  lib.filterAttrs (
                    n: _:
                    lib.elem n [
                      "preview"
                      "render"
                    ]
                  ) templates.quarto.apps.${system}
                );
              };
              expected = {
                site = false;
                tasks = [
                  "preview"
                  "render"
                ];
              };
            };
            testRPackagesFromLockfile = {
              expr =
                let
                  r = (perSystem fixtures.r).nullkomma.r;
                  remotes = (perSystem fixtures.r-remotes).nullkomma.r;
                  has = package: flake: lib.elem package (perSystem flake).nullkomma.r.packages;
                in
                {
                  testthat = has "testthat" fixtures.r;
                  pak = map (has "pak") [
                    fixtures.r
                    fixtures.quarto
                  ];
                  sources = r.lock.sources;
                  remotes = lib.mapAttrs (_: s: s.fetchTree.type or "url") remotes.lock.sources;
                  withr = remotes.lock.sources.withr.fetchTree.rev;
                  withoutLockfile =
                    (builtins.tryEval (builtins.deepSeq (perSystem withoutLockfile).nullkomma.r.packages null)).success;
                };
              expected = {
                testthat = true;
                pak = [
                  true
                  true
                ];
                sources = { };
                remotes = {
                  digest = "url";
                  withr = "github";
                };
                withr = "d82e4bc2d69a34f044ad205210e26207bfb8f3e0";
                withoutLockfile = false;
              };
            };
            testRPpmUrl = {
              expr = fixtures.r.debug.nullkomma.r.ppmUrl;
              expected = "https://packagemanager.posit.co/cran/2026-10-07";
            };
            testRProfileDisabledByDefault = {
              expr = (perSystem fixtures.r).nullkomma.files ? ".Rprofile";
              expected = false;
            };
            testRSnapshot = {
              expr = fixtures.r.debug.nullkomma.r.snapshot;
              expected = "2026-10-07";
            };
            testRHasAirAndCheck = {
              expr = {
                air = (perSystem fixtures.r).treefmt.programs.air.enable;
                check = has fixtures.r.checks "r-cmd-check";
                gitignore = lib.elem "*.Rcheck/" fixtures.r.debug.nullkomma.gitignore;
              };
              expected = {
                air = true;
                check = true;
                gitignore = true;
              };
            };
            testRLibAttrName = {
              expr = nullkomma.lib.r.attrName "data.table";
              expected = "data_table";
            };
            testRLibReadLock = {
              expr =
                let
                  inherit (nullkomma.lib.r) defaultFields readLock;
                  deps = {
                    ref = "deps::.";
                    type = "deps";
                    dep_types = defaultFields;
                  };
                  entry =
                    ref: type: package: extra:
                    {
                      inherit ref type package;
                      version = "1.0";
                      dependencies = [ ];
                      metadata = { };
                      sources = [ "https://example.com/${package}_1.0.tar.gz" ];
                    }
                    // extra;
                  read =
                    args: packages:
                    readLock (
                      {
                        lock = {
                          lockfile_version = 1;
                          packages = [ deps ] ++ packages;
                        };
                        available = {
                          data_table = { };
                          glue = { };
                          withr = { };
                        };
                      }
                      // args
                    );
                  fails = args: packages: !(builtins.tryEval (builtins.deepSeq (read args packages) null)).success;
                  github = entry "r-lib/withr/pkg@abc" "github" "withr" {
                    metadata = {
                      RemoteUsername = "r-lib";
                      RemoteRepo = "withr";
                      RemoteSha = "abc";
                      RemoteSubdir = "pkg";
                    };
                  };
                  url = entry "foo=url::https://example.com/foo_1.0.tar.gz" "url" "foo" { };
                  missing = entry "foo" "standard" "foo" { };
                  allow = {
                    allowOffNixpkgs = true;
                    hashes.foo = "sha256-AAAA";
                  };
                in
                {
                  nixpkgs = read { } [
                    (entry "data.table" "standard" "data.table" { })
                    (entry "glue" "standard" "glue" { })
                  ];
                  offNixpkgs =
                    (read allow [
                      github
                      url
                    ]).sources;
                  rejects = {
                    github = fails { } [ github ];
                    url = fails { } [ url ];
                    missingFromNixpkgs = fails { } [ missing ];
                    pinnedVersion = fails { } [ (entry "glue@1.6.0" "standard" "glue" { }) ];
                    missingHash = fails { allowOffNixpkgs = true; } [ missing ];
                    unsupported = fails allow [ (entry "gitlab::r-lib/foo" "gitlab" "foo" { }) ];
                    format = fails {
                      lock = {
                        lockfile_version = 2;
                        packages = [ deps ];
                      };
                    } [ ];
                    fields = fails { fields = [ "Imports" ]; } [ ];
                  };
                };
              expected = {
                nixpkgs = {
                  nixpkgs = [
                    "data.table"
                    "glue"
                  ];
                  sources = { };
                  refs = [
                    "data.table"
                    "glue"
                  ];
                };
                offNixpkgs = {
                  withr = {
                    fetchTree = {
                      type = "github";
                      owner = "r-lib";
                      repo = "withr";
                      rev = "abc";
                    };
                    subdir = "pkg";
                    version = "1.0";
                    dependencies = [ ];
                  };
                  foo = {
                    fetchurl = {
                      urls = [ "https://example.com/foo_1.0.tar.gz" ];
                      hash = "sha256-AAAA";
                    };
                    version = "1.0";
                    dependencies = [ ];
                  };
                };
                rejects = lib.genAttrs [
                  "github"
                  "url"
                  "missingFromNixpkgs"
                  "pinnedVersion"
                  "missingHash"
                  "unsupported"
                  "format"
                  "fields"
                ] (_: true);
              };
            };
            testTemplatesAreFixtures = {
              expr = map builtins.readFile [
                ../../templates/default/flake.nix
                ../../templates/r/flake.nix
              ];
              expected = map builtins.readFile [
                ../../tests/fixtures/md/flake.nix
                ../../tests/fixtures/r/flake.nix
              ];
            };
            # keep-sorted end
          };
          failures = lib.debug.runTests tests;
          rLockFailure =
            text:
            pkgs.testers.testBuildFailure (
              fixtures.r.checks.${system}.r-lock.overrideAttrs {
                description = pkgs.writeText "DESCRIPTION" text;
              }
            );
          fixtureChecks = lib.concatMapAttrs (
            name: flake:
            lib.mapAttrs' (check: lib.nameValuePair "fixture-${name}-${check}") (
              flake.checks.${system}
              // {
                devshell = flake.devShells.${system}.default;
              }
              // lib.optionalAttrs (has flake.packages "site") {
                site = flake.packages.${system}.site;
              }
            )
          ) fixtures;
        in
        {
          checks = fixtureChecks // {
            r-lock-rejects =
              pkgs.runCommandLocal "nullkomma-r-lock-rejects"
                {
                  stale = rLockFailure ''
                    Package: nullkommafixture
                    Imports: digest
                    Remotes: r-lib/withr@main
                  '';
                  unmet = rLockFailure ''
                    Package: nullkommafixture
                    Suggests: testthat (>= 99.0)
                  '';
                }
                ''
                  grep -q 'depends on digest, which the lockfile lacks' $stale/testBuildFailure.log
                  grep -q 'Remotes: r-lib/withr@main`, which the lockfile lacks' $stale/testBuildFailure.log
                  grep -q 'requires testthat (>= 99.0)' $unmet/testBuildFailure.log
                  touch $out
                '';
            file-initialization = pkgs.runCommandLocal "nullkomma-file-initialization" { } ''
              mkdir project
              cd project
              ${fixtures.r.apps.${system}.write-files.program}
              test -f .github/workflows/push.yml
              test ! -e .Rprofile
              test ! -e .github/workflows/cron.yml
              test -w .github/workflows/push.yml
              if grep -q 'Generated by nullkomma' .github/workflows/push.yml; then
                exit 1
              fi
              printf '# My workflow\n' > .github/workflows/push.yml
              ${fixtures.r.apps.${system}.write-files.program}
              printf '# My workflow\n' > expected
              cmp expected .github/workflows/push.yml
              test ! -e .Rprofile
              test ! -e .github/workflows/cron.yml
              touch $out
            '';
            unit = pkgs.runCommandLocal "nullkomma-unit-tests" { } (
              if failures == [ ] then
                "touch $out"
              else
                ''
                  cat >&2 <<'EOF'
                  ${lib.generators.toPretty { } failures}
                  EOF
                  exit 1
                ''
            );
          };
        };
    };
}
