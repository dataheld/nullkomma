# Shared files have a reviewable upstream baseline; local derivatives are Nix-owned.
{
  flake.framework =
    { flake-parts-lib, lib, ... }:
    {
      options.perSystem = flake-parts-lib.mkPerSystemOption (
        { pkgs, ... }:
        let
          fileModule =
            { name, config, ... }:
            {
              options = {
                enable = lib.mkOption {
                  type = lib.types.bool;
                  default = true;
                  description = "Whether to write `${name}`.";
                };
                mode = lib.mkOption {
                  type = lib.types.enum [
                    "shared"
                    "generated"
                  ];
                  default = "shared";
                  description = "Shared files become project-owned, updated only against an unchanged baseline. Generated files are Nix-owned, locally ignored, and replaced with confirmation.";
                };
                commentPrefix = lib.mkOption {
                  type = lib.types.nullOr lib.types.str;
                  default = null;
                  description = "Line-comment prefix for the generated-file warning (for example // for JSONC). Required for generated files; do not select that mode for formats that cannot carry a warning.";
                };
                text = lib.mkOption {
                  type = lib.types.nullOr lib.types.lines;
                  default = null;
                  description = "File content; sets `source`.";
                };
                source = lib.mkOption {
                  type = lib.types.path;
                  description = "Store path whose content is written to `${name}`.";
                };
              };
              config.source = lib.mkIf (config.text != null) (
                pkgs.writeText "nullkomma-${lib.replaceStrings [ "/" ] [ "-" ] name}" config.text
              );
            };
        in
        {
          options.nullkomma.files = lib.mkOption {
            type = lib.types.attrsOf (lib.types.submodule fileModule);
            default = { };
            description = "Shared initializers and generated local derivatives, keyed by repo-relative path. Builds must use store sources rather than generated workspace copies.";
          };
        }
      );
      config.perSystem =
        { config, pkgs, ... }:
        let
          files = lib.filterAttrs (_: f: f.enable) config.nullkomma.files;
          task = mode: {
            skip = true;
            raw = true; # stream prompts
            description =
              if mode == "shared" then
                "Initialize/update shared files; preserve edits and report upstream conflicts"
              else
                "Generate ignored Nix-owned local files; confirm replacements (--yes for automation)";
            packages = [
              pkgs.coreutils
              pkgs.git
              pkgs.gnugrep
            ];
            command = ''
              mode=${mode}
            ''
            + builtins.readFile ./_files.sh
            + lib.concatStrings (
              lib.mapAttrsToList (
                path: f:
                let
                  source =
                    if mode == "generated" then
                      assert lib.assertMsg (
                        f.commentPrefix != null
                      ) "Generated file ${path} needs a commentPrefix for its ownership warning.";
                      pkgs.concatText "nullkomma-generated-${baseNameOf path}" [
                        (pkgs.writeText "nullkomma-warning" ''
                          ${f.commentPrefix} Generated by nullkomma. DO NOT EDIT; change the Nix configuration.
                        '')
                        f.source
                      ]
                    else
                      f.source;
                in
                ''
                  process_file ${lib.escapeShellArg path} ${lib.escapeShellArg (toString source)}
                ''
              ) (lib.filterAttrs (_: f: f.mode == mode) files)
            )
            + ''
              finish
            '';
          };
        in
        {
          config = {
            nullkomma.tasks.write-files = task "shared";
            nullkomma.tasks.generate-files = task "generated";
          };
        };
    };
}
