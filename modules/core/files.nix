# Files are either a source of truth (written once, then edited and committed)
# or generated from Nix (overwritten on every run and Git-ignored).
{
  framework =
    { flake-parts-lib, lib, ... }:
    {
      options.perSystem = flake-parts-lib.mkPerSystemOption (
        { pkgs, ... }:
        let
          fileModule =
            { name, config, ... }:
            {
              options = {
                enable = lib.mkOption {
                  type = lib.types.bool;
                  default = true;
                  description = "Whether to write `${name}`.";
                };
                mode = lib.mkOption {
                  type = lib.types.enum [
                    "source"
                    "generated"
                  ];
                  default = "source";
                  description = "`source`: written by `write-files`, then a committed source of truth, updated only while unedited. `generated`: written from Nix by `generate-files`, overwritten every run and Git-ignored.";
                };
                commentPrefix = lib.mkOption {
                  type = lib.types.nullOr lib.types.str;
                  default = null;
                  description = "Line-comment prefix for the \"do not edit\" header of generated files (for example // for JSONC). Required for generated files.";
                };
                commentSuffix = lib.mkOption {
                  type = lib.types.str;
                  default = "";
                  description = "Closes the header comment of generated files, for formats without line comments (for example ` -->` with `<!--`).";
                };
                directory = lib.mkOption {
                  type = lib.types.bool;
                  default = false;
                  description = "Whether `source` is a directory, copied whole and without a header. Generated files only.";
                };
                text = lib.mkOption {
                  type = lib.types.nullOr lib.types.lines;
                  default = null;
                  description = "File content; sets `source`.";
                };
                source = lib.mkOption {
                  type = lib.types.path;
                  description = "Store path whose content is written to `${name}`.";
                };
                initialSource = lib.mkOption {
                  type = lib.types.nullOr lib.types.path;
                  default = null;
                  description = "Existing project content used as the initial source-of-truth baseline. The first update is applied only if the on-disk file still matches it.";
                };
              };
              config.source = lib.mkIf (config.text != null) (
                pkgs.writeText "nullkomma-${lib.replaceStrings [ "/" ] [ "-" ] name}" config.text
              );
            };
        in
        {
          options.nullkomma.files = lib.mkOption {
            type = lib.types.attrsOf (lib.types.submodule fileModule);
            default = { };
            description = "Files written into the project, keyed by repo-relative path.";
          };
        }
      );
      config.perSystem =
        { config, pkgs, ... }:
        let
          files = lib.filterAttrs (_: f: f.enable) config.nullkomma.files;
          task = mode: {
            skip = true;
            description =
              if mode == "source" then
                "Write source-of-truth files; keep your edits and report upstream conflicts"
              else
                "Overwrite Git-ignored files generated from Nix";
            packages = [
              pkgs.coreutils
              pkgs.git
            ];
            command = ''
              mode=${mode}
            ''
            + builtins.readFile ./_files.sh
            + lib.concatStrings (
              lib.mapAttrsToList (
                path: f:
                let
                  source =
                    if f.directory then
                      assert lib.assertMsg (mode == "generated") "Directory ${path} must be a generated file.";
                      "${f.source}"
                    else if mode == "generated" then
                      assert lib.assertMsg (
                        f.commentPrefix != null
                      ) "Generated file ${path} needs a commentPrefix for its header.";
                      pkgs.concatText "nullkomma-generated-${baseNameOf path}" [
                        (pkgs.writeText "nullkomma-warning" ''
                          ${f.commentPrefix} Generated by nullkomma. DO NOT EDIT; change the Nix configuration.${f.commentSuffix}
                        '')
                        f.source
                      ]
                    else
                      f.source;
                in
                ''
                  process_file ${lib.escapeShellArg path} ${lib.escapeShellArg (toString source)} ${
                    lib.escapeShellArg (if f.initialSource == null then "" else "${f.initialSource}")
                  }
                ''
              ) (lib.filterAttrs (_: f: f.mode == mode) files)
            )
            + ''
              finish
            '';
          };
        in
        {
          nullkomma.tasks.write-files = task "source";
          nullkomma.tasks.generate-files = task "generated";
        };
    };
}
