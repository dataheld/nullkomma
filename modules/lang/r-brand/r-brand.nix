# Applies `nullkomma.brand` to the `r` plugin's pkgdown website through pkgdown's
# idiom for a shared look: a template package, generated from the brand.
# Optional feature of R, kept separate from its package and workflow implementation.
{
  plugins.r =
    {
      config,
      lib,
      ...
    }:
    let
      cfg = config.nullkomma.r;
      inherit (config.nullkomma) privacy;
      brand =
        if config.nullkomma.brand == null then
          throw "nullkomma.r.pkgdown.brand.enable needs nullkomma.brand"
        else
          config.nullkomma.brand;
    in
    {
      options.nullkomma.r.pkgdown.brand.enable =
        lib.mkEnableOption "the shared brand on the pkgdown website";
      config = lib.mkIf (cfg.enable && cfg.pkgdown.enable && cfg.pkgdown.brand.enable) {
        nullkomma.r.extraPackages = [ "brand.yml" ];
        nullkomma.r.pkgdown.config.template.package = lib.mkDefault "nullkommabrand";
        perSystem =
          { config, pkgs, ... }:
          let
            siteBrand = import ../../../lib/brand.nix {
              inherit pkgs lib brand;
              privacyHref =
                if cfg.pkgdown.privacy.page != null && privacy.policy != { } then
                  cfg.pkgdown.privacy.page
                else
                  null;
            };
            templateConfig.template = {
              light-switch = true;
              bslib.brand = "${brand.lib.brand}";
            };
          in
          {
            nullkomma.r.pkgdown.libraries = [
              (pkgs.runCommand "r-nullkommabrand" { } ''
                mkdir -p src/inst/pkgdown/templates "$out"
                printf '%s\n' 'Package: nullkommabrand' 'Version: 0.0.0' 'Title: Brand pkgdown Template' \
                  'Description: Generated by nullkomma.' 'License: MIT' > src/DESCRIPTION
                touch src/NAMESPACE
                cp ${(pkgs.formats.yaml { }).generate "_pkgdown.yml" templateConfig} src/inst/pkgdown/_pkgdown.yml
                if [[ -s ${siteBrand}/footer.html ]]; then
                  cp ${siteBrand}/footer.html src/inst/pkgdown/templates/footer.html
                fi
                ${config.nullkomma.r.package}/bin/R CMD INSTALL --no-test-load --library="$out" src
              '')
            ];
          };
      };
    };
}
