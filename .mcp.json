{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "nullkomma": {
      "args": [
        "develop",
        "--command",
        "nk",
        "mcp"
      ],
      "command": "nix",
      "type": "stdio"
    },
    "opentofu": {
      "type": "http",
      "url": "https://mcp.opentofu.org/mcp"
    },
    "playwright": {
      "args": [
        "develop",
        "--command",
        "mcp-playwright",
        "--headless",
        "--isolated"
      ],
      "command": "nix",
      "type": "stdio"
    }
  }
}
